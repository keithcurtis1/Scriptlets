on('ready', () => {

    const SCRIPT = {
        CMD_SHOW: '!sharehandout',
        CMD_ASSIGN: '!assign-handout',
        TAG: '_roll20_internal_party_tag_',

        CSS: {
            container: 'border:1px solid #444;background:#222;padding:10px;border-radius:6px; color:#eee;',
            header: 'font-weight:bold;font-size:14px;margin-bottom:6px;color:#eee;',
            section: 'margin-top:6px;font-weight:bold;',
            list: 'margin:6px 0;padding:4px;background:#111;border:1px solid #333;',
            button: 'display:inline-block;margin:2px 2px;padding:4px 8px;background:#3a7bd5;color:#eee;border-radius:4px;text-align:center;',
            instructions: 'font-size:13px;color:#ccc;margin-bottom:6px;'
        }
    };

    /* =========================
       Data Helpers
    ========================= */

    const hasTag = (c) => {
        let tags = c.get('tags');
        if (!tags) return false;

        if (typeof tags === 'string') {
            try {
                const parsed = JSON.parse(tags);
                if (Array.isArray(parsed)) return parsed.includes(SCRIPT.TAG);
            } catch (e) {}
            return tags.split(',').map(t => t.trim()).includes(SCRIPT.TAG);
        }

        if (Array.isArray(tags)) return tags.includes(SCRIPT.TAG);

        return false;
    };

    const getPartyCharacters = () =>
        findObjs({ type: 'character' }).filter(hasTag);

    const getPlayerIdsFromCharacters = (characters) => {
        const ids = new Set();

        characters.forEach(c => {
            (c.get('controlledby') || '').split(',').forEach(id => {
                id = id.trim();
                if (id && id !== 'all') ids.add(id);
            });
        });

        return Array.from(ids);
    };

    const getPlayer = (id) => getObj('player', id);

    /* =========================
       UI Builders
    ========================= */

    const buildHandoutQuery = () => {
        const handouts = findObjs({ type: 'handout' });

        if (!handouts.length) return '?{No handouts available}';

        return `?{Choose Handout to Share|${handouts.map(h => `${h.get('name')},${h.id}`).join('|')}}`;
    };

    const renderUI = () => {

        const characters = getPartyCharacters();
        const playerIds = getPlayerIdsFromCharacters(characters);
        const query = buildHandoutQuery();

        const characterNames = characters.length
            ? characters.map(c => c.get('name')).join(', ')
            : '(No party members found)';

        const playerButtons = playerIds.length
            ? playerIds.map(id => {
                const p = getPlayer(id);
                const name = p ? p.get('_displayname') : '(Unknown)';
                return `<a style="${SCRIPT.CSS.button}" href="${SCRIPT.CMD_ASSIGN} ${query} ${id}">${name}</a>`;
            }).join('')
            : '<div>(No players found)</div>';

        const allButton = `<a style="${SCRIPT.CSS.button}" href="${SCRIPT.CMD_ASSIGN} ${query} all">Share to All</a>`;

        const html =
            `<div style="${SCRIPT.CSS.container}">` +
                `<div style="${SCRIPT.CSS.header}">Party Handout Sharing</div>` +
                `<div style="${SCRIPT.CSS.instructions}">Click a player button (or "Share to All"). You will then be prompted to choose which handout to share.</div>` +                `<div style="${SCRIPT.CSS.section}">Party:</div>` +
                `<div style="${SCRIPT.CSS.list}">${characterNames}</div>` +
                `<div style="${SCRIPT.CSS.section}">Players:</div>` +
                `<div style="${SCRIPT.CSS.list}"><br>${playerButtons}${allButton}</div>` +
            `</div>`;

        sendChat('System', `/w gm ${html}`);
    };



const whisperHandoutLink = (playerId, handout) => {

    const player = getObj('player', playerId);
    if (!player) return;

    const playerName = player.get('_displayname');

    const handoutLink = `http://journal.roll20.net/handout/${handout.id}`;

    const button =
        `<a style="${SCRIPT.CSS.button}" href="${handoutLink}">${handout.get('name')}</a>`;

    const html =
        `<div style="${SCRIPT.CSS.container}">` +
            `<div>The Gamemaster has shared a handout with you. Click below to open.</div>` +
            `<div style="margin-top:6px;">${button}</div>` +
        `</div>`;

    sendChat('System', `/w "${playerName}" ${html}`);
};


    /* =========================
       Permission Logic
    ========================= */

const assignHandout = (handoutId, target) => {

    const handout = getObj('handout', handoutId);

    if (!handout) {
        sendChat('System', `/w gm Invalid handout.`);
        return;
    }

    const characters = getPartyCharacters();
    const partyPlayerIds = getPlayerIdsFromCharacters(characters);

    let targets = [];

    if (target === 'all') {
        targets = partyPlayerIds;
    } else {
        targets = [target];
    }

    let existing =
        (handout.get('inplayerjournals') || '')
            .split(',')
            .filter(Boolean);

    const merged = new Set(existing);

    targets.forEach(id => merged.add(id));

    handout.set(
        'inplayerjournals',
        Array.from(merged).join(',')
    );

    /* =========================
       Whisper Links
    ========================= */

    targets.forEach(playerId => {
        whisperHandoutLink(playerId, handout);
    });

    sendChat(
        'System',
        `/w gm Handout "${handout.get('name')}" updated for ${targets.length} player(s).`
    );
};
    /* =========================
       Chat Handler
    ========================= */

    on('chat:message', (msg) => {
        if (msg.type !== 'api') return;

        if (msg.content.startsWith(SCRIPT.CMD_SHOW)) {
            renderUI();
        }

        if (msg.content.startsWith(SCRIPT.CMD_ASSIGN)) {

            const parts = msg.content.split(' ');
            const handoutId = parts[1];
            const target = parts[2];

            if (!handoutId || !target) {
                sendChat('System', `/w gm Missing parameters.`);
                return;
            }

            assignHandout(handoutId, target);
        }
    });

});
