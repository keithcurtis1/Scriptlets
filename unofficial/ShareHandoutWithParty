on('ready', () => {

    const SCRIPT = {
        CMD_SHOW: '!sharehandout',
        CMD_ASSIGN: '!assign-handout',
        TAG: '_roll20_internal_party_tag_',

        CSS: {
            container: 'border:1px solid #444; background:#222; padding:10px; border-radius:6px;; color:#eee',
            header: 'font-weight:bold; font-size:14px; margin-bottom:6px; color:#eee;',
            list: 'margin:6px 0; padding:4px; background:#111; border:1px solid #333; ; color:#eee',
            button: 'margin-top:8px; padding:6px 10px; background:#3a7bd5; color:#eee; border:none; border-radius:4px; text-align:center;'
        }
    };

    /* =========================
       Utility Functions
    ========================= */

 const getPartyCharacters = () => {
    return findObjs({ type: 'character' }).filter(c => {
        let tags = c.get('tags');

        if (!tags) return false;

        // Handle stringified JSON
        if (typeof tags === 'string') {
            try {
                const parsed = JSON.parse(tags);
                if (Array.isArray(parsed)) {
                    return parsed.includes(SCRIPT.TAG);
                }
            } catch (e) {
                // Not JSON, fall through
            }

            // Handle comma-delimited string
            return tags.split(',').map(t => t.trim()).includes(SCRIPT.TAG);
        }

        // Handle actual array (best case)
        if (Array.isArray(tags)) {
            return tags.includes(SCRIPT.TAG);
        }

        return false;
    });
};

    const getPlayerIdsFromCharacters = (characters) => {
        const ids = new Set();

        characters.forEach(c => {
            const controlled = (c.get('controlledby') || '').split(',');
            controlled.forEach(id => {
                id = id.trim();
                if (id && id !== 'all') {
                    ids.add(id);
                }
            });
        });

        return Array.from(ids);
    };

    const getPlayerNames = (playerIds) => {
        return playerIds.map(id => {
            const p = getObj('player', id);
            return p ? p.get('_displayname') : '(Unknown)';
        });
    };

    const buildHandoutQuery = () => {
        const handouts = findObjs({ type: 'handout' });

        if (!handouts.length) {
            return '?{No handouts available}';
        }

        const options = handouts
            .map(h => `${h.get('name')},${h.id}`)
            .join('|');

        return `?{Select Handout|${options}}`;
    };

const renderUI = (playerNames, query) => {

    const listItems = playerNames.length
        ? playerNames.map(n => `<div>${n}</div>`).join('')
        : '<div>(No players found)</div>';

    const button = `<a style="${SCRIPT.CSS.button}" href="${SCRIPT.CMD_ASSIGN} ${query}">Share Handout</a>`;

    const html = `<div style="${SCRIPT.CSS.container}"><div style="${SCRIPT.CSS.header}">Party Handout Sharing</div><div>Players:</div><div style="${SCRIPT.CSS.list}">${listItems}</div>${button}</div>`;

    sendChat('System', `/w gm ${html}`);
};


    const assignHandout = (handoutId) => {
        const handout = getObj('handout', handoutId);
        if (!handout) {
            sendChat('System', `/w gm Invalid handout selected.`);
            return;
        }

        const characters = getPartyCharacters();
        const playerIds = getPlayerIdsFromCharacters(characters);

        let current = handout.get('inplayerjournals') || '';
        let existing = current ? current.split(',') : [];

        const merged = new Set(existing);

        playerIds.forEach(id => merged.add(id));

        handout.set('inplayerjournals', Array.from(merged).join(','));

        sendChat('System', `/w gm Handout "${handout.get('name')}" shared with ${playerIds.length} player(s).`);
    };

    /* =========================
       Command Handlers
    ========================= */

    on('chat:message', (msg) => {
        if (msg.type !== 'api') return;

        if (msg.content.startsWith(SCRIPT.CMD_SHOW)) {

            const characters = getPartyCharacters();
            const playerIds = getPlayerIdsFromCharacters(characters);
            const playerNames = getPlayerNames(playerIds);
            const query = buildHandoutQuery();

            renderUI(playerNames, query);
        }

        if (msg.content.startsWith(SCRIPT.CMD_ASSIGN)) {

            const parts = msg.content.split(' ');
            const handoutId = parts[1];

            if (!handoutId) {
                sendChat('System', `/w gm No handout specified.`);
                return;
            }

            assignHandout(handoutId);
        }
    });

});
